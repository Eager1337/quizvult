# Public browser config only. Never put a Supabase service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-only secret for Supabase Edge Functions; configure with Supabase secrets, not VITE_ variables.
# GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
# APP_ORIGIN=https://your-deployed-app.example
